# Cadena de conexión de Neon (Dashboard → Connect). Usa la versión "pooled".
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Secreto para firmar las sesiones y cifrar tokens. Genera uno con: openssl rand -hex 32
SESSION_SECRET="pega-aqui-64-caracteres-aleatorios"

# URL pública de la app (se usa en los correos para restablecer contraseña y en los mensajes a Claude)
APP_URL="https://tu-app.vercel.app"

# ── Correos (recuperar contraseña): usa n8n O Resend ──
# Opción n8n: URL de producción del nodo Webhook del workflow public/n8n/enviar-correo.json
N8N_EMAIL_WEBHOOK_URL=""
# Contraseña que inventas; la misma va en la credencial "Header Auth" del webhook (header: x-pendientes-secret)
N8N_EMAIL_SECRET=""

# Opción Resend (https://resend.com). Si está configurado, tiene prioridad sobre n8n.
RESEND_API_KEY=""
# Remitente con tu dominio verificado en Resend, p. ej. "Pendientes <no-reply@tudominio.com>"
EMAIL_FROM=""

# (Opcional) Los datos creados antes de las cuentas se le asignan a quien se registre con este correo.
OWNER_EMAIL=""

# ── Classroom ──
# Secreto del cron diario de Vercel. Genera uno con: openssl rand -hex 32
CRON_SECRET="otro-secreto-aleatorio-de-64-caracteres"
# Cliente OAuth de Google Cloud (tipo "Aplicación web"). Ver README → Classroom.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
