# Cadena de conexión de Neon (Dashboard → Connect). Usa la versión "pooled".
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require"

# Inicio de sesión (solo tú)
APP_USER="eduardo"
APP_PASSWORD="cambia-esto-por-una-contraseña-larga"

# Secreto para firmar la cookie de sesión. Genera uno con: openssl rand -hex 32
SESSION_SECRET="pega-aqui-64-caracteres-aleatorios"
